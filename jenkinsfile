pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Python Version') {
            steps {
                sh 'python3 --version'
            }
        }

        stage('Run Unit Tests') {
            steps {
                sh 'python3 -m unittest -v'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                    -t trajeshk/jenkins-python-app:${BUILD_NUMBER} \
                    -t trajeshk/jenkins-python-app:latest .
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        set -e
                        echo "$DOCKERHUB_TOKEN" | docker login \
                            -u "$DOCKERHUB_USERNAME" --password-stdin

                        docker push trajeshk/jenkins-python-app:${BUILD_NUMBER}
                        docker push trajeshk/jenkins-python-app:latest

                        docker logout
                    '''
                }
            }
        }

        stage('Run Docker Container') {
            steps {
                sh 'docker run --rm trajeshk/jenkins-python-app:${BUILD_NUMBER}'
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                   docker rm -f jenkins-python-app || true
                   docker pull trajeshk/jenkins-python-app:latest
                   docker run -d \
                      --name jenkins-python-app \
                      trajeshk/jenkins-python-app:latest
                  docker ps -a
              '''
	    }
        }

        stage('Build Success') {
            steps {
                echo 'All stages completed successfully!'
            }
        }
    }
}
